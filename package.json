{
  "name": "cider4me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --config vite.config.options.ts",
    "dev:options": "vite --config vite.config.options.ts",
    "build": "bun run build:all",
    "build:all": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "bun scripts/build.ts chrome",
    "build:firefox": "bun scripts/build.ts firefox",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "patchedDependencies": {
    "svelte@5.53.11": "patches/svelte@5.53.11.patch"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@google/genai": "^1.48.0",
    "@mozilla/readability": "^0.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "ai": "^7.0.49",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "^0.577.0",
    "marked": "^17.0.4",
    "svelte": "^5.53.11",
    "vite": "^8.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/bun": "^1.3.10",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "eslint": "^10.0.3",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
